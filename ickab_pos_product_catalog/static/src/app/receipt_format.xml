<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ickab_pos_product_catalog.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
            <attribute name="class" add="ickab-pos-receipt" separator=" "/>
            <attribute name="t-att-style">this.ickabReceiptStyle</attribute>
        </xpath>
        <xpath expr="//Orderline" position="attributes">
            <attribute name="class">{ 'px-0': true, 'ickab-receipt-orderline': true }</attribute>
        </xpath>
        <xpath expr="//div[hasclass('paymentlines')]/t[@t-esc='line.name']" position="replace">
            <span>Medio de pago: <t t-esc="line.name"/></span>
        </xpath>
    </t>
    <t t-name="ickab_pos_product_catalog.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]/span[@t-esc='line.productName']" position="replace">
            <span t-if="line.internalReference" class="ickab-orderline-product-reference text-wrap" t-esc="line.internalReference"/>
            <span class="ickab-orderline-product-name text-wrap" t-esc="line.receiptProductName || line.productName"/>
        </xpath>
    </t>
</templates>
