<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ick_auto_part_vehicle_product_kanban.ProductKanbanRelated">
        <div class="o_ick_related_action" t-if="props.record.data[props.name]">
            <button type="button" class="btn btn-link p-0"
                    title="Ver productos sugeridos, accesorios y opcionales"
                    t-on-click="openRelated">
                <i class="fa fa-car me-1"/>Productos relacionados
            </button>
        </div>
    </t>

    <t t-name="ick_auto_part_vehicle_product_kanban.RelatedProductsDialog">
        <Dialog title="'Productos relacionados'" size="'xl'">
            <div t-if="state.loading" class="py-5 text-center text-muted"><i class="fa fa-spinner fa-spin me-2"/>Consultando productos…</div>
            <div t-elif="state.error" class="alert alert-danger mb-0" t-esc="state.error"/>
            <t t-elif="state.data">
                <div class="fw-bold mb-3" t-esc="state.data.product_name"/>
                <div class="alert alert-info py-2 mb-3" t-if="state.data.selected_warehouse">
                    Disponibilidad para venta en
                    <strong t-esc="state.data.selected_warehouse.name"/>.
                    Use el icono <i class="fa fa-cubes mx-1"/> para consultar todas las tiendas.
                </div>
                <section t-foreach="state.data.sections" t-as="section" t-key="section.key" class="mb-4">
                    <h6><t t-esc="section.label"/> <span class="badge text-bg-secondary" t-esc="section.items.length"/></h6>
                    <div t-if="!section.items.length" class="text-muted small">Sin productos configurados.</div>
                    <div t-else="" class="table-responsive border rounded">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Foto</th><th>SKU</th><th>Nombre</th><th>Marca</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-end">Disponibilidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="section.items" t-as="item" t-key="item.id">
                                    <td><img t-att-src="item.image_url" class="o_ick_dialog_image" t-att-alt="item.name"/></td>
                                    <td t-esc="item.sku"/>
                                    <td t-esc="item.name"/>
                                    <td t-esc="item.brand"/>
                                    <td class="text-end" t-esc="this.money(item)"/>
                                    <td class="text-end text-nowrap">
                                        <span class="fw-semibold"
                                              t-att-class="item.available_qty &gt; 0 ? 'text-success' : 'text-danger'"
                                              t-esc="this.quantity(item)"/>
                                        <button type="button" class="btn btn-sm btn-link p-0 ms-2"
                                                title="Disponibilidad en todas las tiendas"
                                                t-att-data-product-id="item.id"
                                                t-on-click="(ev) => this.openStock(ev)">
                                            <i class="fa fa-cubes"/>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            </t>
            <t t-set-slot="footer"><button class="btn btn-secondary" t-on-click="props.close">Cerrar</button></t>
        </Dialog>
    </t>

    <t t-name="ick_auto_part_vehicle_product_kanban.RelatedProductStockDialog">
        <Dialog title="'Disponibilidad por tienda'" size="'lg'">
            <div t-if="state.loading" class="py-5 text-center text-muted">
                <i class="fa fa-spinner fa-spin me-2"/>Consultando existencias…
            </div>
            <div t-elif="state.error" class="alert alert-danger mb-0" t-esc="state.error"/>
            <t t-elif="state.data">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <img t-att-src="state.data.product.image_url"
                         class="o_ick_dialog_image o_ick_dialog_image_lg"
                         t-att-alt="state.data.product.name"/>
                    <div>
                        <div class="fw-bold" t-esc="state.data.product.name"/>
                        <div class="small text-muted" t-esc="state.data.product.sku"/>
                    </div>
                </div>
                <div class="table-responsive border rounded" t-if="state.data.warehouses.length">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Tienda / almacén</th><th class="text-end">Disponible para venta</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.data.warehouses" t-as="warehouse" t-key="warehouse.id"
                                t-att-class="warehouse.selected ? 'table-info' : ''">
                                <td>
                                    <span t-esc="warehouse.name"/>
                                    <span t-if="warehouse.selected" class="badge text-bg-info ms-2">Seleccionada</span>
                                </td>
                                <td class="text-end fw-semibold"
                                    t-att-class="warehouse.available &gt; 0 ? 'text-success' : 'text-danger'"
                                    t-esc="this.quantity(warehouse.available, warehouse.uom)"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div t-else="" class="alert alert-info mb-0">
                    No existen cantidades registradas en almacenes internos.
                </div>
            </t>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="props.close">Cerrar</button>
            </t>
        </Dialog>
    </t>
</templates>
