<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ick_auto_part_vehicle_product_kanban.ProductKanbanRelated">
        <div class="o_ick_related_action" t-if="props.record.data[props.name]">
            <button type="button" class="btn btn-link p-0"
                    title="Ver productos sugeridos, accesorios y opcionales"
                    t-on-click="openRelated">
                <i class="fa fa-car me-1"/>Productos relacionados
            </button>
        </div>
    </t>

    <t t-name="ick_auto_part_vehicle_product_kanban.RelatedProductsDialog">
        <Dialog title="'Productos relacionados'" size="'xl'">
            <div t-if="state.loading" class="py-5 text-center text-muted"><i class="fa fa-spinner fa-spin me-2"/>Consultando productos…</div>
            <div t-elif="state.error" class="alert alert-danger mb-0" t-esc="state.error"/>
            <t t-elif="state.data">
                <div class="fw-bold mb-3" t-esc="state.data.product_name"/>
                <section t-foreach="state.data.sections" t-as="section" t-key="section.key" class="mb-4">
                    <h6><t t-esc="section.label"/> <span class="badge text-bg-secondary" t-esc="section.items.length"/></h6>
                    <div t-if="!section.items.length" class="text-muted small">Sin productos configurados.</div>
                    <div t-else="" class="table-responsive border rounded">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th>Foto</th><th>SKU</th><th>Nombre</th><th>Marca</th><th class="text-end">Precio</th></tr></thead>
                            <tbody><tr t-foreach="section.items" t-as="item" t-key="item.id"><td><img t-att-src="item.image_url" class="o_ick_dialog_image" t-att-alt="item.name"/></td><td t-esc="item.sku"/><td t-esc="item.name"/><td t-esc="item.brand"/><td class="text-end" t-esc="this.money(item)"/></tr></tbody>
                        </table>
                    </div>
                </section>
            </t>
            <t t-set-slot="footer"><button class="btn btn-secondary" t-on-click="props.close">Cerrar</button></t>
        </Dialog>
    </t>
</templates>
