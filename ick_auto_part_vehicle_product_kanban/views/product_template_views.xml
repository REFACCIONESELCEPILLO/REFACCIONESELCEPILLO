<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_kanban_automotive_tools" model="ir.ui.view">
        <field name="name">product.template.kanban.automotive.tools</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban/templates" position="before">
                <field name="ick_kanban_has_related"/>
            </xpath>
            <xpath expr="//templates//field[@name='ick_kanban_compatibility_codes'][1]" position="after">
                <field name="ick_kanban_has_related"
                       widget="ick_product_kanban_related"
                       class="w-100"/>
            </xpath>
        </field>
    </record>
</odoo>
