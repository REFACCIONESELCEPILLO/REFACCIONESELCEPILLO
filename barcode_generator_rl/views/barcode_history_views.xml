<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="barcode_generated_history_rl_list_view" model="ir.ui.view">
        <field name="name">barcode.generated.history.rl.list</field>
        <field name="model">barcode.generated.history.rl</field>
        <field name="arch" type="xml">
            <list string="Historial de códigos generados" create="0" edit="0" delete="0">
                <field name="generated_at"/>
                <field name="barcode"/>
                <field name="product_id"/>
                <field name="barcode_type"/>
                <field name="sequence_value"/>
                <field name="config_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="barcode_generated_history_rl_action" model="ir.actions.act_window">
        <field name="name">Historial de códigos generados</field>
        <field name="res_model">barcode.generated.history.rl</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_barcode_generated_history_rl"
              name="Historial de códigos generados"
              parent="base.menu_custom"
              action="barcode_generated_history_rl_action"
              sequence="71"
              groups="base.group_system"/>
</odoo>
