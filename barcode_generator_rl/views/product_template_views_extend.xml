<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="barcode_image_rl_view_product_template_form_extended" model="ir.ui.view">
        <field name="name">barcode.image.rl.view.product.template.form.extended</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <button name="action_generate_configured_barcode"
                        type="object"
                        string="Generar"
                        icon="fa-barcode"
                        class="btn-link"
                        groups="barcode_generator_rl.group_barcode_generator_user"
                        invisible="barcode or product_variant_count != 1 or type in ['service', 'combo']"/>
                <field name="barcode_image" widget="image"
                       invisible="product_variant_count &gt; 1 or type in ['service', 'combo'] or not barcode_image"
                       options="{'preview_image': 'barcode_image','size': [420, 160]}" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="barcode_image_rl_view_product_product_form_extended" model="ir.ui.view">
        <field name="name">barcode.image.rl.view.product.product.form.extended</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <button name="action_generate_configured_barcode"
                        type="object"
                        string="Generar"
                        icon="fa-barcode"
                        class="btn-link"
                        groups="barcode_generator_rl.group_barcode_generator_user"
                        invisible="barcode"/>
                <field name="barcode_image" widget="image"
                       options="{'preview_image': 'barcode_image','size': [420, 160]}"
                       invisible="not barcode_image" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
