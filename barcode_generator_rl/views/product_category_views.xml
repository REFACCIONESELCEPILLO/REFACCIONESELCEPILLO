<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_barcode_rl" model="ir.ui.view">
        <field name="name">product.category.form.barcode.rl</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="barcode_category_code" groups="base.group_system" placeholder="01"/>
            </xpath>
        </field>
    </record>

    <record id="product_category_list_barcode_rl" model="ir.ui.view">
        <field name="name">product.category.list.barcode.rl</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="barcode_category_code" optional="show" groups="base.group_system"/>
            </xpath>
        </field>
    </record>
</odoo>
