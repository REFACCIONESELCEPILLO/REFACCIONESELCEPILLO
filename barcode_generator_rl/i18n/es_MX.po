#. module: barcode_generator_rl
#: model_terms:ir.ui.view,arch_db:barcode_generator_rl.product_barcode_missing_image_generator_view
msgid ""
"<i class=\"fa fa-exclamation-triangle\" style=\"margin-right:6px;\"/>\n"
"                    <b>Recommended:</b> Use <b>Code 128</b> if you don’t know the exact length/format of your barcode number.\n"
"                    Fixed-length formats (EAN-13 / EAN-8 / UPC-A / ISBN / ISSN) require strict digit counts and check digits.\n"
"                    Incompatible inputs will create wrong barcode image."
msgstr ""
"<i class=\"fa fa-exclamation-triangle\" style=\"margin-right:6px;\"/>\n"
"                    <b>Recomendación:</b> Use <b>Code 128</b> si desconoce la longitud o el formato exactos del número de su código de barras.\n"
"                    Los formatos de longitud fija (EAN-13 / EAN-8 / UPC-A / ISBN / ISSN) requieren una cantidad exacta de dígitos y dígitos de control válidos.\n"
"                    Los valores incompatibles generarán una imagen de código de barras incorrecta."

