<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_barcode_wizard_rl_form_view" model="ir.ui.view">
        <field name="name">product.barcode.wizard.rl.form.view</field>
        <field name="model">product.barcode.generator.rl</field>
        <field name="arch" type="xml">
            <form string="Product Barcode Generator">
                <group>
                    <group>
                        <field name="config_id"/>
                        <field name="barcode_type"/>
                        <field name="override_barcode"/>
                    </group>
                    <group string="Previsualización">
                        <field name="preview_code" readonly="1"/>
                        <field name="preview_message" readonly="1"/>
                        <field name="preview_image" widget="image" readonly="1" options="{'size': [480, 160]}"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not override_barcode">
                    La sobrescritura sólo afecta esta operación manual. La generación masiva nunca reemplaza barcodes existentes.
                </div>
                <footer>
                    <button name="action_generate_barcode" type="object" string="Generate Barcode" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_barcode_wizard" model="ir.actions.server">
        <field name="name">Product Barcode Generator</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_product_barcode_wizard()</field>
        <field name="groups_id" eval="[(4, ref('barcode_generator_rl.group_barcode_generator_user'))]"/>
    </record>

    <record id="action_product_variant_barcode_wizard" model="ir.actions.server">
        <field name="name">Product Barcode Generator</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_product_variant_barcode_wizard()</field>
        <field name="groups_id" eval="[(4, ref('barcode_generator_rl.group_barcode_generator_user'))]"/>
    </record>
</odoo>
