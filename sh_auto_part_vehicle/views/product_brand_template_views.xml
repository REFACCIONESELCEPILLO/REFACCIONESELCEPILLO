<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Campo "Marca" en el formulario de producto. -->
    <record id="product_template_form_brand_sale_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.product.brand.sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="ickab_brand_id" options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
