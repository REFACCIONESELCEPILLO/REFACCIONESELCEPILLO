    <!-- Product Template onyl form-->
    <record id="sh_product_only_form" model="ir.ui.view">
        <field name="name">sh.product.only.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
			<xpath expr="//page[last()]" position="after">		
				<page name="motorcycle" string="Vehículos">
					<group>
                        <group string="Clasificación automotriz">
                            <field name="sh_is_common_product" string="¿Producto universal?"/>
                            <field name="product_type" string="Tipo de producto" widget="many2many_tags" invisible="sh_is_common_product"/>
                            <field name="brand" string="Marca" invisible="sh_is_common_product"/>
                            <field name="made_in" string="Hecho en" invisible="sh_is_common_product"/>
                        </group>
                        <group string="Características compatibles" invisible="sh_is_common_product">
                            <field name="garde" string="Calificación" widget="many2many_tags"/>
                            <field name="engine" string="Motor" widget="many2many_tags"/>
                            <field name="transmission_ids" string="Transmisión" widget="many2many_tags"/>
                        </group>
					</group>
                    <separator string="Aplicaciones vehiculares" invisible="sh_is_common_product"/>
					<field name="motorcycle_ids" nolabel="1" invisible="sh_is_common_product">
						<list editable="bottom">
							<field name="make_id" string="Fabricante"/>
							<field name="mmodel_id" string="Modelo"/>
							<field name="year_id" string="Año de inicio"/>
							<field name="end_year_id" string="Año de finalización"/>
						</list>
						<form>
                            <group>
                                <field name="make_id" string="Fabricante"/>
                                <field name="mmodel_id" string="Modelo"/>
                                <field name="year_id" string="Año de inicio"/>
                                <field name="end_year_id" string="Año de finalización"/>
                            </group>
                        </form>
					</field>
				</page>
				<page name="Vehicle OEM" string="Vehicle OEM">
					 <field name="vehicle_oem_lines" widget="one2many" context="{'show_attribute': False}">
                        <list string="Variants" editable="bottom">
                        	 <field name="name"/>
                        	 <field name="brand_id" string="Marca" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        	 <field name="is_visible_website"/>
                             <field name="company_id" groups="base.group_multi_company"/>
                             <field name="website_id" groups="website.group_multi_website"/>
                        </list>
                     </field>
				</page>
				
				<page name="Specification" string="Specification">
					 <field name="specification_lines" widget="one2many" context="{'show_attribute': False}">
                        <list editable="bottom">
                        	 <field name="name"/>
                        	 <field name="value"/>
                             <field name="company_id" groups="base.group_multi_company"/>
                             <field name="website_id" groups="website.group_multi_website"/>
                        </list>
                     </field>
				</page>
			</xpath>	
			
        </field>
    </record>
</odoo>
