<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_motorcycle_product_normal_form" model="ir.ui.view">
        <field name="name">sh.motorcycle.product.normal.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="motorcycle" string="Vehículos">
	                	<group>
                            <group string="Clasificación automotriz">
                                <field name="sh_is_common_product" string="¿Producto universal?"/>
                                <field name="product_type" string="Tipo de producto" widget="many2many_tags" invisible="sh_is_common_product"/>
                                <field name="brand" string="Marca" invisible="sh_is_common_product"/>
                                <field name="made_in" string="Hecho en" invisible="sh_is_common_product"/>
                            </group>
                            <group string="Características compatibles" invisible="sh_is_common_product">
                                <field name="garde" string="Calificación" widget="many2many_tags"/>
                                <field name="engine" string="Motor" widget="many2many_tags"/>
                                <field name="transmission_ids" string="Transmisión" widget="many2many_tags"/>
                            </group>
					</group>
                    <separator string="Aplicaciones vehiculares" invisible="sh_is_common_product"/>
                    <field name="motorcycle_ids" nolabel="1" invisible="sh_is_common_product">
                        <list editable="bottom">
                            <field name="make_id" string="Fabricante"/>
                            <field name="mmodel_id" string="Modelo"/>
                            <field name="year_id" string="Año de inicio"/>
                            <field name="end_year_id" string="Año de finalización"/>
                        </list>
                        <form>
                            <group>
                                <field name="make_id" string="Fabricante"/>
                                <field name="mmodel_id" string="Modelo"/>
                                <field name="year_id" string="Año de inicio"/>
                                <field name="end_year_id" string="Año de finalización"/>
                            </group>
                        </form>
                    </field>
                    
                </page>
            </xpath>
            
        </field>
    </record>
    
