<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Compatibility bridge for the current modular deployment.

        These views were temporarily absorbed by the core during the paused
        normalization work. Their original addons remain installed, so keeping
        both implementations active duplicates Marca and makes two OEM kanban
        views replace the same stock block. Preserve the records for a future
        migration, but keep them inactive while the modular addons coexist.
    -->
    <record id="product_template_search_oem_inherit" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
    <record id="product_template_kanban_oem_inherit" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

