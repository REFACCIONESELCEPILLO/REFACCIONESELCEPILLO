<odoo>
    <template id="dps_report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
        <xpath expr="//th[@name='th_quantity']" position="before">
            <th name="th_max_height" style="width:10%; white-space: nowrap;">Alto</th>
            <th name="th_max_width" style="width:10%; white-space: nowrap;">Ancho</th>
        </xpath>

        <xpath expr="//td[@name='td_quantity']" position="before">
            <td class="text-end"><span t-field="line.height_cm"/></td>
            <td class="text-end"><span t-field="line.width_cm"/></td>
        </xpath>
    </template>
</odoo>
