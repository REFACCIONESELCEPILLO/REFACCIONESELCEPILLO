<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="product_dimension.ptav_select_lookup">
        <div class="o_mocalli_ptav_selector d-flex flex-grow-1 gap-2">
            <select
                class="o_input flex-grow-1"
                t-on-change="updateSelectedPTAV"
                t-att-name="'ptal-' + this.props.id">
                <option
                    t-foreach="sortedDimensionValues"
                    t-as="ptav"
                    t-key="ptav.id"
                    t-att-value="ptav.id"
                    t-att-selected="this.props.selected_attribute_value_ids.includes(ptav.id)"
                    t-out="getDimensionPTAVSelectName(ptav)"
                    t-att-class="{ 'css_not_available': ptav.excluded }"
                />
            </select>
            <button type="button"
                    class="btn btn-outline-secondary o_mocalli_open_value_search"
                    title="Abrir búsqueda avanzada"
                    aria-label="Abrir búsqueda avanzada"
                    t-on-click="openDimensionValueSearch">
                <i class="fa fa-search" aria-hidden="true"/>
            </button>
        </div>
    </t>
</templates>
