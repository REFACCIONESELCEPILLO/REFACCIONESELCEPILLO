<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ick_auto_part_vehicle_extends_pos.ProductScreen"
       t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-screen')]" position="attributes">
            <attribute name="class" add="o_auto_pos_workspace" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('rightpane')]" position="after">
            <AutoPartsPosPanel productId="autoContextProductId"
                               t-if="!ui.isSmall || pos.mobile_pane === 'right'"/>
        </xpath>
    </t>

    <t t-name="ick_auto_part_vehicle_extends_pos.AutoPartsPosPanel">
        <aside class="o_auto_pos_panel d-flex flex-column">
            <section class="o_auto_pos_ad" t-if="pos.config.ick_auto_show_advertising">
                <div class="o_auto_pos_ad_placeholder">
                    <i class="fa fa-bullhorn"/>
                    <div>
                        <strong>Espacio publicitario</strong>
                        <small>Área reservada para el módulo de publicidad.</small>
                    </div>
                </div>
            </section>
            <div class="o_auto_pos_loading" t-if="state.loading">
                <i class="fa fa-spinner fa-spin"/> Cargando sugerencias…
            </div>
            <div class="o_auto_pos_hint" t-elif="!state.panel.active_product">
                <i class="fa fa-info-circle"/>
                Seleccione una línea del carrito para consultar piezas relacionadas.
            </div>
            <div class="o_auto_pos_hint" t-elif="!hasAnySuggestion">
                No hay recomendaciones configuradas para este producto.
            </div>

            <div class="o_auto_pos_scroll" t-else="">
                <section class="o_auto_pos_group">
                    <t t-foreach="primarySections" t-as="section" t-key="section.key">
                        <t t-call="ick_auto_part_vehicle_extends_pos.Section"/>
                    </t>
                </section>
                <section class="o_auto_pos_group o_auto_pos_suggested">
                    <div class="o_auto_pos_group_title">Productos sugeridos</div>
                    <t t-foreach="suggestedSections" t-as="section" t-key="section.key">
                        <t t-call="ick_auto_part_vehicle_extends_pos.Section"/>
                    </t>
                </section>
            </div>
        </aside>
    </t>

    <t t-name="ick_auto_part_vehicle_extends_pos.Section">
        <div class="o_auto_pos_section" t-if="section.items.length">
            <button type="button" class="o_auto_pos_section_header"
                    t-on-click="() => this.toggle(section.key)">
                <span t-esc="section.label"/>
                <span class="badge rounded-pill" t-esc="section.items.length"/>
                <i t-att-class="state.open[section.key] ? 'fa fa-chevron-up' : 'fa fa-chevron-down'"/>
            </button>
            <div class="o_auto_pos_cards" t-if="state.open[section.key]">
                <article class="o_auto_pos_card" t-foreach="section.items"
                         t-as="item" t-key="item.id">
                    <img class="o_auto_pos_image" t-att-src="item.image_url"
                         t-att-alt="item.name"/>
                    <div class="o_auto_pos_data">
                        <strong class="o_auto_pos_name" t-esc="item.name"/>
                        <div class="o_auto_pos_meta">
                            <span t-if="item.default_code" t-esc="item.default_code"/>
                            <span t-if="item.brand" t-esc="item.brand"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-end gap-1">
                            <span class="o_auto_pos_price" t-esc="this.price(item)"/>
                            <button type="button" class="btn btn-link btn-sm p-0"
                                    title="Disponibilidad por almacén"
                                    t-att-class="item.available_qty &gt; 0 ? 'text-success' : 'text-danger'"
                                    t-on-click="() => this.showStock(item)">
                                <i class="fa fa-cubes me-1"/>
                                <span t-esc="this.quantity(item)"/>
                            </button>
                        </div>
                    </div>
                    <div class="o_auto_pos_actions">
                        <button t-if="item.has_compatibility" type="button"
                                class="btn btn-outline-secondary btn-sm"
                                title="Ver aplicaciones vehiculares"
                                t-on-click="() => this.showCompatibility(item)">
                            <i class="fa fa-car"/>
                        </button>
                        <button type="button" class="btn btn-primary btn-sm o_auto_pos_add"
                                t-att-disabled="state.addingProductId"
                                t-on-click="() => this.add(item)">
                            <i t-if="state.addingProductId === item.id" class="fa fa-spinner fa-spin"/>
                            <span t-else="">Agregar</span>
                        </button>
                    </div>
                </article>
            </div>
        </div>
    </t>

    <t t-name="ick_auto_part_vehicle_extends_pos.AutoPosInfoDialog">
        <Dialog title="title" size="'xl'">
            <div class="text-center p-4" t-if="state.loading">
                <i class="fa fa-spinner fa-spin"/> Cargando…
            </div>
            <div class="alert alert-danger mb-0" t-elif="state.error" t-esc="state.error"/>
            <t t-elif="props.mode === 'stock'">
                <table class="table table-sm table-striped mb-0" t-if="state.data.warehouses.length">
                    <thead><tr><th>Almacén</th><th class="text-end">Disponible</th></tr></thead>
                    <tbody>
                        <tr t-foreach="state.data.warehouses" t-as="row" t-key="row.id">
                            <td t-esc="row.name"/>
                            <td class="text-end" t-esc="this.quantity(row.available, row.uom)"/>
                        </tr>
                    </tbody>
                </table>
                <div class="text-muted text-center p-3" t-else="">Sin existencias registradas por almacén.</div>
            </t>
            <t t-else="">
                <t t-set="partDetails" t-value="state.data.part_details || []"/>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <h3 class="mb-0">Compatibilidad automotriz</h3>
                    <span t-if="state.data.applications.length" class="badge text-bg-primary ms-auto">
                        <t t-esc="state.data.application_count"/> aplicaciones
                    </span>
                </div>
                <div class="table-responsive border rounded mb-3" t-if="state.data.applications.length || partDetails.length">
                    <table class="table table-sm table-hover align-middle text-center mb-0">
                        <thead class="table-light"><tr>
                            <th>Armadora</th><th>Modelo</th><th>Tipo</th><th>Años</th><th>Motor</th><th>Transmisión</th><th>Grado</th>
                            <th t-foreach="partDetails" t-as="detail" t-key="detail.label"
                                t-esc="detail.label === 'Tipo de producto de vehículo' ? 'Familias de Autopartes' : detail.label"/>
                        </tr></thead>
                        <tbody>
                            <tr t-foreach="state.data.applications" t-as="row" t-key="row.id">
                                <td t-esc="row.make"/><td t-esc="row.model"/><td t-esc="row.type"/>
                                <td><t t-esc="row.year_from"/><t t-if="row.year_to"> – <t t-esc="row.year_to"/></t></td>
                                <td t-esc="row.engines"/><td t-esc="row.transmissions"/><td t-esc="row.grades"/>
                                <td t-foreach="partDetails" t-as="detail" t-key="detail.label" t-esc="detail.value"/>
                            </tr>
                            <tr t-if="!state.data.applications.length">
                                <td colspan="7" class="text-muted">Sin detalle vehicular registrado</td>
                                <td t-foreach="partDetails" t-as="detail" t-key="detail.label" t-esc="detail.value"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-info" t-if="!state.data.applications.length and state.data.oem.length">
                    Equivalencias OEM registradas. El detalle vehicular aún no está registrado.
                </div>
                <div class="text-muted text-center p-3" t-elif="!state.data.applications.length">
                    Sin aplicaciones vehiculares ni códigos OEM registrados.
                </div>
                <small class="text-muted" t-if="state.data.truncated">
                    Se muestran las primeras <t t-esc="state.data.applications.length"/>
                    de <t t-esc="state.data.application_count"/> aplicaciones.
                </small>
                <h3 class="mt-3">Códigos OEM</h3>
                <div class="table-responsive border rounded" t-if="state.data.oem.length">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light"><tr><th>Código OEM</th><th>Marca</th></tr></thead>
                        <tbody>
                            <tr t-foreach="state.data.oem" t-as="oem" t-key="oem.id">
                                <td class="fw-bold" t-esc="oem.code"/><td t-esc="oem.brand"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="text-muted" t-else="">Sin códigos OEM registrados.</div>
            </t>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">Cerrar</button>
            </t>
        </Dialog>
    </t>
</templates>
