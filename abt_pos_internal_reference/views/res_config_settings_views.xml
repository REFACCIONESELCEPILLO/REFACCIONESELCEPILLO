<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_product_label" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.product.label</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting string="Identificación del producto" help="Elige si el POS muestra la referencia interna, el nombre o ambos.">
                    <field name="pos_product_label_mode"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
