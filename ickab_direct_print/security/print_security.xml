<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ickab_direct_print" model="ir.module.category">
        <field name="name">ICKAB Direct Print</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_direct_print_user" model="res.groups">
        <field name="name">Usuario de impresión directa</field>
        <field name="category_id" ref="ickab_direct_print.module_category_ickab_direct_print"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_direct_print_manager" model="res.groups">
        <field name="name">Administrador de impresión directa</field>
        <field name="category_id" ref="ickab_direct_print.module_category_ickab_direct_print"/>
        <field name="implied_ids" eval="[(4, ref('ickab_direct_print.group_direct_print_user'))]"/>
    </record>

    <!-- Los usuarios con permisos de Ajustes administran Direct Print automáticamente. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('ickab_direct_print.group_direct_print_manager'))]"/>
    </record>

    <record id="rule_print_host_company" model="ir.rule">
        <field name="name">Direct Print Hosts por compañía</field>
        <field name="model_id" ref="model_ickab_print_host"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ickab_direct_print.group_direct_print_user'))]"/>
    </record>

    <record id="rule_print_printer_company" model="ir.rule">
        <field name="name">Direct Print Printers por compañía</field>
        <field name="model_id" ref="model_ickab_print_printer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ickab_direct_print.group_direct_print_user'))]"/>
    </record>

    <record id="rule_print_paper_company" model="ir.rule">
        <field name="name">Direct Print Papers globales o por compañía</field>
        <field name="model_id" ref="model_ickab_print_paper"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ickab_direct_print.group_direct_print_user'))]"/>
    </record>

    <record id="rule_print_profile_company" model="ir.rule">
        <field name="name">Direct Print Profiles por compañía</field>
        <field name="model_id" ref="model_ickab_print_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ickab_direct_print.group_direct_print_user'))]"/>
    </record>

    <record id="rule_print_job_company" model="ir.rule">
        <field name="name">Direct Print Jobs por compañía</field>
        <field name="model_id" ref="model_ickab_print_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ickab_direct_print.group_direct_print_user'))]"/>
    </record>
</odoo>
