<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ickab_print_compatibility_profile_search" model="ir.ui.view">
        <field name="name">ickab.print.compatibility.profile.search</field>
        <field name="model">ickab.print.compatibility.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="manufacturer"/>
                <field name="model_name"/>
                <filter string="Validados" name="validated" domain="[('validation_status','in',['catalog','lab','production'])]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Fabricante" name="group_manufacturer" context="{'group_by':'manufacturer'}"/>
                    <filter string="Lenguaje" name="group_language" context="{'group_by':'language'}"/>
                    <filter string="Validación" name="group_validation" context="{'group_by':'validation_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ickab_print_compatibility_profile_list" model="ir.ui.view">
        <field name="name">ickab.print.compatibility.profile.list</field>
        <field name="model">ickab.print.compatibility.profile</field>
        <field name="arch" type="xml">
            <list decoration-success="validation_status in ('lab','production')" decoration-info="validation_status == 'catalog'">
                <field name="name"/>
                <field name="manufacturer"/>
                <field name="model_name"/>
                <field name="printer_type"/>
                <field name="language"/>
                <field name="dpi"/>
                <field name="recommended_transport" optional="hide"/>
                <field name="validation_status" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ickab_print_compatibility_profile_form" model="ir.ui.view">
        <field name="name">ickab.print.compatibility.profile.form</field>
        <field name="model">ickab.print.compatibility.profile</field>
        <field name="arch" type="xml">
            <form string="Perfil de compatibilidad">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="manufacturer"/>
                            <field name="model_name"/>
                            <field name="name_pattern"/>
                            <field name="priority"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="printer_type"/>
                            <field name="language"/>
                            <field name="alternate_languages"/>
                            <field name="dpi"/>
                            <field name="recommended_transport"/>
                            <field name="validation_status"/>
                        </group>
                    </group>
                    <group string="Calibración del renderer" invisible="printer_type != 'label'">
                        <group>
                            <field name="label_direction"/>
                            <field name="origin_x_dots"/>
                            <field name="origin_y_dots"/>
                        </group>
                        <group invisible="language != 'tspl'">
                            <field name="supports_inline_bitmap"/>
                            <field name="tspl_scalable_font0"/>
                            <field name="tspl_bitmap_one_is_black" invisible="not supports_inline_bitmap"/>
                        </group>
                    </group>
                    <group string="Referencia técnica">
                        <field name="source_reference"/>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ickab_print_compatibility_profile" model="ir.actions.act_window">
        <field name="name">Compatibilidad de impresoras</field>
        <field name="res_model">ickab.print.compatibility.profile</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ickab_print_compatibility_profile_search"/>
    </record>


</odoo>
