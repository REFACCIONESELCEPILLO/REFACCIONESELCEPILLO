<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ickab_print_paper_list" model="ir.ui.view">
        <field name="name">ickab.print.paper.list</field>
        <field name="model">ickab.print.paper</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="size_description"/>
                <field name="orientation"/>
                <field name="default_dpi"/>
                <field name="sensor_mode" invisible="category != 'label'"/>
                <field name="gap_mm" invisible="category != 'label' or sensor_mode == 'continuous'"/>
                <field name="gap_offset_mm" invisible="category != 'label' or sensor_mode == 'continuous'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ickab_print_paper_form" model="ir.ui.view">
        <field name="name">ickab.print.paper.form</field>
        <field name="model">ickab.print.paper</field>
        <field name="arch" type="xml">
            <form string="Tipo de papel">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="width_mm"/>
                            <field name="height_mm"/>
                            <field name="orientation"/>
                            <field name="default_dpi"/>
                            <field name="sensor_mode" invisible="category != 'label'"/>
                            <field name="gap_mm" invisible="category != 'label' or sensor_mode == 'continuous'"/>
                            <field name="gap_offset_mm" invisible="category != 'label' or sensor_mode == 'continuous'"/>
                            <field name="size_description" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ickab_print_paper" model="ir.actions.act_window">
        <field name="name">Tipos de papel</field>
        <field name="res_model">ickab.print.paper</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
