<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ickab_print_assignment_search" model="ir.ui.view">
        <field name="name">ickab.print.assignment.search</field>
        <field name="model">ickab.print.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="branch_id"/>
                <field name="printer_id"/>
                <filter string="Predeterminadas" name="default" domain="[('is_default','=',True)]"/>
                <filter string="Activas" name="active" domain="[('active','=',True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Sucursal" name="group_branch" context="{'group_by':'branch_id'}"/>
                    <filter string="Usuario" name="group_user" context="{'group_by':'user_id'}"/>
                    <filter string="Tipo" name="group_kind" context="{'group_by':'document_kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ickab_print_assignment_list" model="ir.ui.view">
        <field name="name">ickab.print.assignment.list</field>
        <field name="model">ickab.print.assignment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="branch_id"/>
                <field name="user_id"/>
                <field name="document_kind"/>
                <field name="host_id" readonly="1" optional="show"/>
                <field name="printer_id"/>
                <field name="paper_id" optional="hide"/>
                <field name="copies"/>
                <field name="priority" optional="hide"/>
                <field name="is_default"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ickab_print_assignment_form" model="ir.ui.view">
        <field name="name">ickab.print.assignment.form</field>
        <field name="model">ickab.print.assignment</field>
        <field name="arch" type="xml">
            <form string="Asignación de impresión">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="user_id"/>
                            <field name="document_kind"/>
                        </group>
                        <group>
                            <field name="printer_id"/>
                            <field name="host_id" readonly="1"/>
                            <field name="paper_id"/>
                            <field name="copies"/>
                            <field name="priority"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ickab_print_assignment" model="ir.actions.act_window">
        <field name="name">Asignaciones por usuario</field>
        <field name="res_model">ickab.print.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ickab_print_assignment_search"/>
    </record>
</odoo>
