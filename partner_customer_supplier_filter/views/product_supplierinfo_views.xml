<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_supplierinfo_form_partner_classification" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.partner.classification</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="domain">[('is_supplier', '=', True)]</attribute>
                <attribute name="context">
                    {
                        'res_partner_search_mode': 'supplier',
                        'default_is_supplier': True,
                    }
                </attribute>
            </field>
        </field>
    </record>

    <record id="product_supplierinfo_list_partner_classification" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.partner.classification</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="domain">[('is_supplier', '=', True)]</attribute>
                <attribute name="context">
                    {
                        'res_partner_search_mode': 'supplier',
                        'default_is_supplier': True,
                    }
                </attribute>
            </field>
        </field>
    </record>

    <record id="purchase_supplierinfo_list_partner_classification" model="ir.ui.view">
        <field name="name">purchase.supplierinfo.list.partner.classification</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="purchase.product_supplierinfo_tree_view2"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="domain">[('is_supplier', '=', True)]</attribute>
                <attribute name="context">
                    {
                        'res_partner_search_mode': 'supplier',
                        'default_is_supplier': True,
                    }
                </attribute>
            </field>
        </field>
    </record>
</odoo>
