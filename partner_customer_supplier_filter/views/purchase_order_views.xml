<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_partner_classification" model="ir.ui.view">
        <field name="name">purchase.order.form.partner.classification</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="domain">[('is_supplier', '=', True)]</attribute>
                <attribute name="context">
                    {
                        'res_partner_search_mode': 'supplier',
                        'show_vat': True,
                        'default_is_supplier': True,
                    }
                </attribute>
            </field>
        </field>
    </record>
</odoo>
