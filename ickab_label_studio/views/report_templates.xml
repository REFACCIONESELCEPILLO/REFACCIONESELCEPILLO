<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_label_zpl" model="ir.actions.report">
        <field name="name">ICKAB Label Studio - ZPL</field>
        <field name="model">ickab.label.template</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">ickab_label_studio.report_label_zpl</field>
        <field name="report_file">ickab_label_studio.report_label_zpl</field>
        <field name="print_report_name">'ICKAB_Label_Studio'</field>
    </record>

    <record id="action_report_label_preview" model="ir.actions.report">
        <field name="name">ICKAB Label Studio - Preview</field>
        <field name="model">ickab.label.template</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">ickab_label_studio.report_label_preview</field>
        <field name="report_file">ickab_label_studio.report_label_preview</field>
    </record>

    <template id="report_label_zpl"><t>ICKAB Label Studio</t></template>

    <template id="report_label_preview">
        <t t-call="web.html_container">
            <div class="container py-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="m-0"><t t-esc="docs.name"/></h3>
                    <span class="badge text-bg-secondary">Vista previa</span>
                </div>
                <t t-if="not pages"><div class="alert alert-warning">No hay etiquetas para previsualizar.</div></t>
                <t t-foreach="pages" t-as="page">
                    <div class="mb-4">
                        <div t-if="page.get('raw_mode')" class="alert alert-warning py-2">
                            ZPL RAW: esta vista representa únicamente los objetos reconocidos durante la importación. La exportación conserva el ZPL original.
                        </div>
                        <div t-att-style="page['page_style']">
                            <t t-if="page.get('safe_margin_mm')">
                                <div t-att-style="page['safe_style']"></div>
                            </t>
                            <t t-foreach="page['elements']" t-as="el">
                                <div t-att-style="el['preview_container_style']">
                                    <t t-if="el.get('type') == 'text'">
                                        <div t-att-style="el['preview_text_style']"><t t-esc="el['value_resolved']"/></div>
                                    </t>
                                    <t t-elif="el.get('type') == 'barcode'">
                                        <img t-if="el.get('preview_src')" t-att-src="el['preview_src']" style="display:block;width:100%;height:100%;object-fit:fill;"/>
                                    </t>
                                    <t t-elif="el.get('type') == 'qrcode'">
                                        <img t-if="el.get('preview_src')" t-att-src="el['preview_src']" style="display:block;width:100%;height:100%;object-fit:contain;"/>
                                    </t>
                                    <t t-elif="el.get('type') == 'image'">
                                        <img t-if="el.get('preview_src')" t-att-src="el['preview_src']" style="display:block;width:100%;height:100%;object-fit:contain;image-rendering:auto;"/>
                                        <div t-else="" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;border:1px dashed #999;color:#777;font-size:9px;">SIN IMAGEN</div>
                                    </t>
                                    <t t-elif="el.get('type') == 'box'">
                                        <div t-att-style="el['preview_box_style']"></div>
                                    </t>
                                    <t t-elif="el.get('type') == 'line'">
                                        <div t-if="el.get('line_direction') == 'vertical'" t-att-style="el['preview_line_style']"></div>
                                        <div t-else="" t-att-style="el['preview_line_style']"></div>
                                    </t>
                                </div>
                            </t>
                        </div>
                        <div class="text-muted mt-1">
                            <t t-esc="'{} × {} mm · {} · {} DPI'.format(page['width_mm'], page['height_mm'], page.get('shape'), page['template'].dpi)"/>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
