<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_label_layout_form_ickab_studio" model="ir.ui.view">
        <field name="name">product.label.layout.form.ickab.studio</field>
        <field name="model">product.label.layout</field>
        <field name="inherit_id" ref="product.product_label_layout_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='print_format']" position="after">
                <field name="ickab_label_template_id" invisible="print_format != 'ickab_label_studio'" required="print_format == 'ickab_label_studio'"/>
            </xpath>
            <xpath expr="//footer" position="inside">
                <button name="action_ickab_label_preview" type="object" string="Previsualizar" class="btn-secondary" invisible="print_format != 'ickab_label_studio'"/>
            </xpath>
        </field>
    </record>
</odoo>
