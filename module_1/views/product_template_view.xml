<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_warehouse_availability_form_inherit" model="ir.ui.view">
        <field name="name">product.template.warehouse.availability.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_warehouse_availability"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-building-o"
                    groups="stock.group_stock_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Disponible</span>
                        <span class="o_stat_text">por almacen</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Existencias" groups="stock.group_stock_user,sales_team.group_sale_salesman">
                    <group string="Resumen por almacen">
                        <field name="warehouse_free_qty_kanban" readonly="1" widget="text" nolabel="1"/>
                    </group>
                    <field name="warehouse_availability_ids" readonly="1" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="warehouse_name"/>
                            <field name="quantity_on_hand" string="Fisico" sum="Total fisico"/>
                            <field name="reserved_quantity" string="Reservado" sum="Total reservado"/>
                            <field name="free_quantity" string="Disponible" sum="Total disponible"/>
                            <field name="product_uom_id" string="UdM"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
