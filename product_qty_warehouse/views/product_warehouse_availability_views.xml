<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_warehouse_availability_tree_view" model="ir.ui.view">
        <field name="name">product.warehouse.availability.list</field>
        <field name="model">product.warehouse.availability</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="warehouse_id"/>
                <field name="product_id"/>
                <field name="quantity_on_hand" string="Fisico" sum="Total fisico"/>
                <field name="reserved_quantity" sum="Total reservado"/>
                <field name="free_quantity" string="Disponible" sum="Total disponible"/>
                <field name="product_uom_id" string="UdM"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="product_warehouse_availability_pivot_view" model="ir.ui.view">
        <field name="name">product.warehouse.availability.pivot</field>
        <field name="model">product.warehouse.availability</field>
        <field name="arch" type="xml">
            <pivot string="Disponible por almacen">
                <field name="warehouse_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="free_quantity" string="Disponible" type="measure"/>
                <field name="quantity_on_hand" string="Fisico" type="measure"/>
                <field name="reserved_quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="product_warehouse_availability_search_view" model="ir.ui.view">
        <field name="name">product.warehouse.availability.search</field>
        <field name="model">product.warehouse.availability</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="product_tmpl_id"/>
                <field name="warehouse_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="available" string="Con disponible" domain="[('free_quantity', '&gt;', 0)]"/>
                <filter name="group_by_warehouse" string="Almacen" context="{'group_by': 'warehouse_id'}"/>
                <filter name="group_by_product" string="Producto" context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="product_warehouse_availability_action" model="ir.actions.act_window">
        <field name="name">Disponible por almacen</field>
        <field name="res_model">product.warehouse.availability</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="product_warehouse_availability_search_view"/>
        <field name="context">{'search_default_available': 1, 'search_default_group_by_warehouse': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay disponibilidad libre para mostrar.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_product_warehouse_availability"
        name="Disponible por almacen"
        action="product_warehouse_availability_action"
        parent="stock.menu_warehouse_report"
        sequence="35"
        groups="stock.group_stock_user"/>
</odoo>
